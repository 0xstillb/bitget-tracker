# Multi-trader format (v3) — Name:portfolioId[:type], comma-separated
# type = "cfd" (default) or "futures"
# The portfolioId is the number at the end of the my-portfolio URL on Bitget
TRADERS=TraderName:YOUR_PORTFOLIO_ID,Futures:YOUR_FUTURES_PORTFOLIO_ID:futures

# Cookie from Bitget (paste via dashboard, or set here as fallback on redeploy)
BITGET_COOKIE=

# Required for all state-changing and diagnostic administration endpoints.
# Generate with: openssl rand -hex 32
WRITE_TOKEN=

# Required only by the read-only Pi viewer for GET /internal/v1/snapshot.
# Generate a separate value with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Core must bind only to loopback or this VPS's Tailscale 100.64.0.0/10 address.
CORE_BIND_HOST=127.0.0.1
# Explicit browser origins only; comma-separated. Do not use *.
CORE_CORS_ORIGINS=http://localhost

# Poll interval in seconds (default 30)
POLL_INTERVAL_SEC=30

# Optional one-shot Core health alerts. Choose exactly one provider.
# State must live on the persistent VPS volume, never on Pi/mobile.
ALERT_PROVIDER=
ALERT_STATE_PATH=alert-state.json
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Renew an authenticated cookie this many seconds before its expiry (default: 6h).
COOKIE_RENEWAL_THRESHOLD_SEC=21600

# Legacy single-trader vars (ignored when TRADERS is set)
# PORTFOLIO_ID=YOUR_PORTFOLIO_ID
# TRADER_NAME=TraderName
