# Tailscale-only Core endpoint; never use a public URL.
CORE_SNAPSHOT_URL=http://100.64.0.10:10000/internal/v1/snapshot
# Same value as the VPS INTERNAL_API_TOKEN. Keep this file mode 0600.
INTERNAL_API_TOKEN=
CORE_SNAPSHOT_TIMEOUT_SEC=5

# Pi LAN service for the ESP32 and local Viewer only.
PI_VIEWER_BIND_HOST=0.0.0.0
PI_VIEWER_PORT=8080
PI_VIEWER_CACHE_PATH=/var/lib/bitget-pi-viewer/viewer-cache.json
